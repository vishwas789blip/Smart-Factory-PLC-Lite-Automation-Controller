[
  {
    "id": "tab_smart_factory",
    "type": "tab",
    "label": "Smart Factory SCADA & IoT",
    "disabled": false,
    "info": "HCLTech BTech Embedded Systems & IoT Node-RED SCADA Flow"
  },
  {
    "id": "mqtt_broker_hivemq",
    "type": "mqtt-broker",
    "name": "HiveMQ Public Broker",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "node-red-smart-factory",
    "autoConnect": true,
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "sub_telemetry",
    "type": "mqtt in",
    "z": "tab_smart_factory",
    "name": "ESP32 Telemetry",
    "topic": "factory/telemetry/#",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 140,
    "wires": [["fn_parse_metrics", "debug_telemetry"]]
  },
  {
    "id": "fn_parse_metrics",
    "type": "function",
    "z": "tab_smart_factory",
    "name": "Extract Readings",
    "func": "const r = msg.payload.readings || {};\nreturn [\n    { payload: r.temperature || 0, topic: 'Temperature (°C)' },\n    { payload: r.vibration || 0, topic: 'Vibration (mm/s)' },\n    { payload: r.current || 0, topic: 'Motor Current (A)' }\n];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 140,
    "wires": [
      ["ui_temp_gauge", "sw_temp_threshold"],
      ["ui_vibe_chart", "sw_vibe_threshold"],
      ["ui_curr_gauge"]
    ]
  },
  {
    "id": "sw_temp_threshold",
    "type": "switch",
    "z": "tab_smart_factory",
    "name": "Temp > 75°C?",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      { "t": "gt", "v": "75", "vt": "num" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 580,
    "y": 100,
    "wires": [["fn_fan_on_cmd"]]
  },
  {
    "id": "fn_fan_on_cmd",
    "type": "function",
    "z": "tab_smart_factory",
    "name": "Build Fan ON Cmd",
    "func": "msg.payload = JSON.stringify({\n    target: 'FAN',\n    action: 'TURN_ON',\n    reason: 'Node-RED High Temp Automation'\n});\nreturn msg;",
    "outputs": 1,
    "x": 780,
    "y": 100,
    "wires": [["pub_actuator_cmd"]]
  },
  {
    "id": "sw_vibe_threshold",
    "type": "switch",
    "z": "tab_smart_factory",
    "name": "Vibe > 4.5 mm/s?",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      { "t": "gt", "v": "4.5", "vt": "num" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 590,
    "y": 180,
    "wires": [["fn_halt_conveyor_cmd"]]
  },
  {
    "id": "fn_halt_conveyor_cmd",
    "type": "function",
    "z": "tab_smart_factory",
    "name": "Halt Conveyor Cmd",
    "func": "msg.payload = JSON.stringify({\n    target: 'CONVEYOR',\n    action: 'TURN_OFF',\n    reason: 'Excessive Mechanical Oscillation'\n});\nreturn msg;",
    "outputs": 1,
    "x": 800,
    "y": 180,
    "wires": [["pub_actuator_cmd"]]
  },
  {
    "id": "pub_actuator_cmd",
    "type": "mqtt out",
    "z": "tab_smart_factory",
    "name": "Publish Control",
    "topic": "factory/actuator/plc-001/control",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_hivemq",
    "x": 1020,
    "y": 140,
    "wires": []
  },
  {
    "id": "debug_telemetry",
    "type": "debug",
    "z": "tab_smart_factory",
    "name": "Telemetry Stream",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 370,
    "y": 240,
    "wires": []
  }
]
